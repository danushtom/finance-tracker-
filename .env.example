# ---- Database -------------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DB=finance_tracker

# ---- Auth -------------------------------------------------------------------
# Required, no default — startup fails loudly if this is empty (NFR-8).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# Empty = open registration. Set this to lock down a self-hosted instance
# (FR-1.8) — note: Docker Compose's .env parser does NOT support inline
# comments, so any value here must be on its own line, not trailing "# ...".
REGISTRATION_INVITE_CODE=

# ---- Storage ------------------------------------------------------------
STORAGE_DIR=/storage/uploads
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=20000

# ---- LLM categorisation fallback (FR-4.2, NFR-10, NFR-11) -----------------
# Which provider to use for merchant categorisation fallback. One of:
#   gemini | claude | none
# This is only the *default* for newly created users — each user can override
# it (and their own API keys) from Settings; see users.settings.llm in the
# data model. Leaving both keys empty disables the LLM fallback everywhere
# and the app remains fully functional on rules only (NFR-11, FR-4.12).
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_MONTHLY_CALL_CAP=500

# ---- OCR (P1, feature-flagged) --------------------------------------------
OCR_ENABLED=false

# ---- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---- Misc -------------------------------------------------------------------
TZ=Asia/Kolkata
LOG_LEVEL=INFO
ENV=development
